# ══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ══════════════════════════════════════════════════════

# PostgreSQL (Payment, Orders, Inventory contexts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here  # ← CAMBIAR EN PRODUCCIÓN
POSTGRES_DB=ecommerce
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000

# MongoDB (Billing read models)
MONGODB_URL=mongodb://admin:your_secure_password@localhost:27017/billing? authSource=admin
MONGODB_DATABASE=billing

# EventStoreDB (Event Sourcing)
EVENTSTORE_URL=esdb://localhost:2113? tls=false

# RabbitMQ (Event Bus)
RABBITMQ_URL=amqp://admin:your_secure_password@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3

# ══════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ══════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ══════════════════════════════════════════════════════
# EXTERNAL SERVICES (Para después)
# ══════════════════════════════════════════════════════

# Stripe (Payment Gateway)
# STRIPE_SECRET_KEY=sk_test_... 
# STRIPE_WEBHOOK_SECRET=whsec_... 

# SAT/SUNAT (Facturación)
# SAT_API_URL=https://api.sat.gob.mx
# SAT_API_KEY=... 

