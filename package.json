{
  "name": "ddd-architecture-journey",
  "version": "1.0.0",
  "description": "DDD + Clean Architecture + Event Sourcing + CQRS + Sagas - Real e-commerce system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index. js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --watch src --exec ts-node src/index.ts",
    "build:watch": "tsc --watch",
    "test": "jest --runInBand",
    "test:unit": "jest src/tests/unit --runInBand",
    "test:integration": "jest src/tests/integration --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:infrastructure": "jest src/tests/integration/infrastructure --runInBand",
    "docker: up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "db:migrate": "node dist/infrastructure/database/migrations/run.js"
  },
  "keywords": [
    "ddd",
    "clean-architecture",
    "cqrs",
    "event-sourcing",
    "saga",
    "microservices"
  ],
  "author": "Sadelx29",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "testcontainers": "^10.4.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@eventstore/db-client": "^6.2.1",
    "amqplib": "^0.10.3",
    "dotenv": "^17.2.3",
    "mongodb": "^6.3.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  }
}
